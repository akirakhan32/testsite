---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CTABand from "../components/CTABand.astro";
import HeroPipeline3D from "../components/HeroPipeline3D.astro";
import MechCardDiagram from "../components/MechCardDiagram.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import { services, methodSteps, fitIf, notFitIf } from "../data/services";

const homeServices = services.filter((s) => s.home);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/"); // always ends with /
---
<BaseLayout title="CodifyPros — Replace the manual work. Keep the judgment.">
  <ScrollProgress />
  <SiteHeader slot="header" />

  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Operations · Systems · AI</p>
        <h1>Replace the manual work. Keep the judgment.</h1>
        <p class="lede">
          CodifyPros replaces manual operations with intelligent systems — software, agents, and workflows that run the work.
        </p>
        <div class="hero__actions">
          <a class="btn btn-primary" href={`${base}contact`}>Talk to us</a>
          <a class="text-link hero__secondary" href={`${base}services`}>What we build →</a>
        </div>
        <div class="hero__crumbs" aria-label="Trust signals">
          <span>Pakistan HQ</span>
          <span>US reach</span>
        </div>
      </div>
      <HeroPipeline3D />
    </div>
  </section>

  <section class="stuck" aria-labelledby="stuck-heading">
    <div class="wrap" data-reveal>
      <p class="eyebrow">Sound familiar?</p>
      <h2 id="stuck-heading">Leads in inboxes. Updates in spreadsheets. Handoffs that die in chat.</h2>
      <p class="lede">
        That manual ops tax compounds every week. We build systems that run the work — so your team keeps the judgment, not the copy-paste.
      </p>
      <div class="stuck__chips">
        <span class="chip">Copy-paste CRM</span>
        <span class="chip">Status archaeology</span>
        <span class="chip">Tool sprawl</span>
      </div>
      <a class="text-link" href="#mechanisms">See how we fix it →</a>
    </div>
  </section>

  <section class="section stakes" aria-labelledby="stakes-heading">
    <div class="wrap" data-reveal>
      <p class="eyebrow">The cost</p>
      <h2 id="stakes-heading">Every week you wait, the tax compounds.</h2>
      <p class="lede">
        Hours vanish into status, handoffs, and tools that don’t talk. Errors hide in the gaps. The work doesn’t get cheaper — it gets messier.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <header class="section-header" data-reveal>
        <p class="eyebrow">What we build</p>
        <h2 id="services-heading">Systems that remove the busywork.</h2>
      </header>
      <div class="service-rows" data-reveal-stagger>
        {homeServices.map((s) => (
          <a class="service-row" data-reveal href={`${base}services#${s.slug}`}>
            <div>
              <h3 class="service-row__name">{s.name}</h3>
              <p class="service-row__outcome">{s.outcome}</p>
            </div>
            <span class="service-row__tag">{s.tag}</span>
            <span class="service-row__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <p class="services-foot">
        <a class="text-link" href={`${base}services`}>All services →</a>
      </p>
    </div>
  </section>

  <section class="section" id="method" aria-labelledby="method-heading">
    <div class="wrap">
      <header class="section-header" data-reveal>
        <p class="eyebrow">Method</p>
        <h2 id="method-heading">Audit → Build → Activate → Compound</h2>
      </header>
      <div class="method-grid" data-reveal-stagger>
        {methodSteps.map((step) => (
          <article class="process-step" data-reveal>
            <div class="process-step__index">{step.index}</div>
            <h3 class="process-step__title">{step.title}</h3>
            <p class="process-step__body">{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="mechanisms" aria-labelledby="mech-heading">
    <div class="wrap">
      <header class="section-header" data-reveal>
        <p class="eyebrow">How it works</p>
        <h2 id="mech-heading">Systems, not slideware.</h2>
        <p class="lede">How value happens. Named cases replace this when we have permission to publish them.</p>
      </header>
      <div class="mech-grid" data-reveal-stagger>
        <article class="mech-card" data-reveal>
          <span class="craft-mark" aria-hidden="true"></span>
          <MechCardDiagram variant="intake" />
          <p class="eyebrow">Intake → route</p>
          <h3>Work arrives once and finds an owner.</h3>
          <p>Inbox, form, or CRM event lands in the right queue — no hunting, no “who has this?”</p>
        </article>
        <article class="mech-card" data-reveal>
          <MechCardDiagram variant="loop" />
          <p class="eyebrow">Human-in-the-loop</p>
          <h3>Judgment stays with people.</h3>
          <p>Bots handle the repeatable steps. Exceptions pause for a human, then the system continues.</p>
        </article>
        <article class="mech-card" data-reveal>
          <MechCardDiagram variant="exception" />
          <p class="eyebrow">Exception queue</p>
          <h3>Failures surface. They don’t hide in chat.</h3>
          <p>Broken steps, missing data, and stalled jobs show up as work to clear — not silent drift.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="fit-heading">
    <div class="wrap">
      <header class="section-header" data-reveal>
        <p class="eyebrow">Honest fit</p>
        <h2 id="fit-heading">We’re a fit if you want a system, not a demo.</h2>
      </header>
      <div class="fit-band" data-reveal-stagger>
        <div class="fit-card fit-card--yes" data-reveal>
          <h3>We’re a fit if</h3>
          <ul>
            {fitIf.slice(0, 3).map((x) => (
              <li>{x}</li>
            ))}
          </ul>
        </div>
        <div class="fit-card fit-card--no" data-reveal>
          <h3>We’re not if</h3>
          <ul>
            {notFitIf.slice(0, 3).map((x) => (
              <li>{x}</li>
            ))}
          </ul>
        </div>
      </div>
      <p class="services-foot">
        <a class="text-link" href={`${base}services#fit-heading`}>Full fit check →</a>
      </p>
    </div>
  </section>

  <CTABand />
  <SiteFooter slot="footer" />
</BaseLayout>
