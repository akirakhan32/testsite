---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CTABand from "../components/CTABand.astro";
import { services, methodSteps } from "../data/services";

const homeServices = services.filter((s) => s.home);
---
<BaseLayout title="CodifyPros — Replace the manual work. Keep the judgment.">
  <SiteHeader slot="header" />

  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Operations · Systems · AI</p>
        <h1>Replace the manual work. Keep the judgment.</h1>
        <p class="lede">
          CodifyPros replaces manual operations with intelligent systems — software, agents, and workflows that run the work.
        </p>
        <div class="hero__actions">
          <a class="btn btn-primary" href="/contact">Talk to us</a>
          <a class="text-link hero__secondary" href="/services">What we build →</a>
        </div>
        <div class="hero__crumbs" aria-label="Trust signals">
          <span>Pakistan HQ</span>
          <span>US reach</span>
        </div>
      </div>
      <div class="hero__frame" aria-hidden="true">
        <span class="craft-mark"></span>
        <div class="hero__frame-inner">
          <div class="cu">// ops.pipeline</div>
          <div>ingest → classify → route</div>
          <div class="ok">✓ lead scored · owner assigned</div>
          <div>sheet sync · crm writeback</div>
          <div class="ok">✓ exception queue cleared</div>
          <div style="margin-top: 1.5em; opacity: 0.55">awaiting operator review…</div>
        </div>
      </div>
    </div>
  </section>

  <section class="stuck" aria-labelledby="stuck-heading">
    <div class="wrap" data-reveal>
      <p class="eyebrow">Sound familiar?</p>
      <h2 id="stuck-heading">Leads in inboxes. Updates in spreadsheets. Handoffs that die in chat.</h2>
      <p class="lede">
        That manual ops tax compounds every week. We build systems that run the work — so your team keeps the judgment, not the copy-paste.
      </p>
      <div class="stuck__chips">
        <span class="chip">Copy-paste CRM</span>
        <span class="chip">Status archaeology</span>
        <span class="chip">Tool sprawl</span>
      </div>
      <a class="text-link" href="#method">See how we fix it →</a>
    </div>
  </section>

  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <header class="section-header" data-reveal>
        <p class="eyebrow">What we build</p>
        <h2 id="services-heading">Systems that remove the busywork.</h2>
      </header>
      <div class="service-rows" data-reveal-stagger>
        {homeServices.map((s) => (
          <a class="service-row" data-reveal href={`/services#${s.slug}`}>
            <div>
              <h3 class="service-row__name">{s.name}</h3>
              <p class="service-row__outcome">{s.outcome}</p>
            </div>
            <span class="service-row__tag">{s.tag}</span>
            <span class="service-row__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <p class="services-foot">
        <a class="text-link" href="/services">All services →</a>
      </p>
    </div>
  </section>


  <section class="section" id="mechanisms" aria-labelledby="mech-heading" data-reveal-stagger>
    <div class="wrap">
      <header class="section-header" data-reveal>
        <p class="eyebrow">How systems land</p>
        <h2 id="mech-heading">Three ways we remove the busywork.</h2>
        <p class="lede">No vanity metrics — these are the patterns we ship. Real case studies appear when we have permission to name them.</p>
      </header>
      <div class="mech-grid">
        <article class="mech-card" data-reveal>
          <p class="eyebrow">01</p>
          <h3>Connect the tools you already have</h3>
          <p>CRM, sheets, inbox, and ops tools stop living in separate worlds. Events flow; people stop copy-pasting.</p>
        </article>
        <article class="mech-card" data-reveal>
          <p class="eyebrow">02</p>
          <h3>Automate the judgment-free steps</h3>
          <p>Routing, enrichment, reminders, and status updates run without babysitting — humans keep the exceptions.</p>
        </article>
        <article class="mech-card" data-reveal>
          <p class="eyebrow">03</p>
          <h3>Put AI where work already happens</h3>
          <p>Models and agents wire into real workflows — not demo chat windows that dump more work on your team.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="method" aria-labelledby="method-heading">
    <div class="wrap">
      <header class="section-header" data-reveal>
        <p class="eyebrow">Method</p>
        <h2 id="method-heading">Audit → Build → Activate → Compound</h2>
      </header>
      <div class="method-grid" data-reveal-stagger>
        {methodSteps.map((step) => (
          <article class="process-step" data-reveal>
            <div class="process-step__index">{step.index}</div>
            <h3 class="process-step__title">{step.title}</h3>
            <p class="process-step__body">{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABand />
  <SiteFooter slot="footer" />
</BaseLayout>
