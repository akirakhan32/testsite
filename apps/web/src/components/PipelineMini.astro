---
/** Static SVG pipeline header for Services — no WebGL. */
---
<svg
  class="pipeline-mini"
  viewBox="0 0 640 80"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <rect x="8" y="28" width="72" height="28" rx="2" stroke="currentColor" stroke-width="1.25" />
  <line x1="80" y1="42" x2="140" y2="42" stroke="currentColor" stroke-width="1.25" />
  <rect x="140" y="22" width="88" height="40" rx="2" stroke="var(--copper)" stroke-width="1.5" />
  <line x1="228" y1="42" x2="300" y2="42" stroke="currentColor" stroke-width="1.25" />
  <rect x="300" y="28" width="72" height="28" rx="2" stroke="currentColor" stroke-width="1.25" />
  <line x1="372" y1="42" x2="440" y2="42" stroke="currentColor" stroke-width="1.25" />
  <rect x="440" y="22" width="88" height="40" rx="2" stroke="currentColor" stroke-width="1.25" />
  <line x1="528" y1="42" x2="580" y2="42" stroke="currentColor" stroke-width="1.25" />
  <rect x="580" y="32" width="44" height="20" rx="2" stroke="currentColor" stroke-width="1.25" opacity="0.7" />
  <circle cx="184" cy="42" r="3" fill="var(--copper)" />
  <text x="18" y="70" fill="currentColor" font-size="9" font-family="ui-monospace,monospace" letter-spacing="0.08em" opacity="0.65">INTAKE</text>
  <text x="158" y="70" fill="var(--copper)" font-size="9" font-family="ui-monospace,monospace" letter-spacing="0.08em">ROUTE</text>
  <text x="312" y="70" fill="currentColor" font-size="9" font-family="ui-monospace,monospace" letter-spacing="0.08em" opacity="0.65">BUILD</text>
  <text x="452" y="70" fill="currentColor" font-size="9" font-family="ui-monospace,monospace" letter-spacing="0.08em" opacity="0.65">ACTIVATE</text>
</svg>

<style>
  .pipeline-mini {
    display: block;
    width: 100%;
    max-width: 640px;
    height: auto;
    margin: 28px 0 8px;
    color: var(--muted);
  }
</style>
