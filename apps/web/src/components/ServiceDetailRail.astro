---
/** Copper scroll-spy rail for Services page — tracks active service section. */
interface Props {
  slugs: string[];
  labels: string[];
}
const { slugs, labels } = Astro.props;
---
<nav class="service-rail" data-service-rail aria-label="On this page">
  <div class="service-rail__track" aria-hidden="true">
    <span class="service-rail__thumb" data-service-rail-thumb></span>
  </div>
  <ul class="service-rail__list">
    {slugs.map((slug, i) => (
      <li>
        <a class="service-rail__link" href={`#${slug}`} data-rail-link={slug}>
          {labels[i]}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .service-rail {
    display: none;
  }
  @media (min-width: 1100px) {
    .service-rail {
      display: block;
      position: sticky;
      top: 96px;
      align-self: start;
      width: 140px;
      flex-shrink: 0;
    }
  }
  .service-rail__track {
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 2px;
    background: var(--line);
  }
  .service-rail__thumb {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 28px;
    background: var(--copper);
    transition: transform 280ms var(--ease-out);
    will-change: transform;
  }
  .service-rail__list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .service-rail__link {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 160ms var(--ease-out);
  }
  .service-rail__link.is-active,
  .service-rail__link:hover {
    color: var(--paper);
  }
  .service-rail__link.is-active {
    color: var(--copper);
  }
  @media (prefers-reduced-motion: reduce) {
    .service-rail__thumb {
      transition: none;
    }
  }
</style>

<script>
  const rail = document.querySelector("[data-service-rail]");
  if (rail) {
    const links = Array.from(rail.querySelectorAll("[data-rail-link]"));
    const thumb = rail.querySelector("[data-service-rail-thumb]");
    const sections = links
      .map((a) => document.getElementById(a.dataset.railLink || ""))
      .filter(Boolean);

    const setActive = (id) => {
      links.forEach((a, i) => {
        const on = a.dataset.railLink === id;
        a.classList.toggle("is-active", on);
        if (on && thumb) {
          const li = a.parentElement;
          if (li) thumb.style.transform = `translateY(${li.offsetTop}px)`;
        }
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible[0]?.target?.id) setActive(visible[0].target.id);
      },
      { rootMargin: "-20% 0px -55% 0px", threshold: [0.1, 0.35, 0.6] }
    );
    sections.forEach((s) => io.observe(s));
    if (sections[0]) setActive(sections[0].id);
  }
</script>
