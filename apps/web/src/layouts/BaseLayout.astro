---
import plexSans400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import instrument400 from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/instrument-serif/latin-400.css";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "CodifyPros replaces manual operations with intelligent systems — software, agents, and workflows that run the work.",
} = Astro.props;
const pageTitle = title.includes("CodifyPros") ? title : `${title} · CodifyPros`;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/"); // always ends with /
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E1014" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CodifyPros" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CodifyPros" />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
    <link rel="preload" href={plexSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={instrument400} as="font" type="font/woff2" crossorigin />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell">
      <slot name="header" />
      <main id="main">
        <slot />
      </main>
      <slot name="footer" />
    </div>
    <div class="sticky-cta" data-sticky-cta hidden>
      <div class="wrap sticky-cta__inner">
        <span class="sticky-cta__copy">Stuck in manual ops?</span>
        <a class="btn btn-primary" href={`${base}contact`}>Talk to us</a>
        <button class="sticky-cta__dismiss" type="button" data-sticky-dismiss aria-label="Dismiss">×</button>
      </div>
    </div>
    <script>
      const bar = document.querySelector("[data-sticky-cta]");
      const path = location.pathname.replace(/\/$/, "") || "/";
      const dismissed = sessionStorage.getItem("cp-sticky-dismiss") === "1";
      const onContact = path.endsWith("/contact");
      if (bar && !onContact && !dismissed) {
        const hero = document.querySelector(".hero, .page-hero");
        if (hero) {
          const io = new IntersectionObserver(
            ([e]) => {
              const show = !e.isIntersecting;
              bar.hidden = !show;
              bar.classList.toggle("is-on", show);
              document.documentElement.classList.toggle("has-sticky-cta", show);
            },
            { threshold: 0.05 }
          );
          io.observe(hero);
        }
        bar.querySelector("[data-sticky-dismiss]")?.addEventListener("click", () => {
          sessionStorage.setItem("cp-sticky-dismiss", "1");
          bar.hidden = true;
          bar.classList.remove("is-on");
          document.documentElement.classList.remove("has-sticky-cta");
        });
      } else if (bar) {
        bar.remove();
      }
    </script>
    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll("[data-reveal-stagger]").forEach((parent) => {
        parent.querySelectorAll(":scope > [data-reveal]").forEach((el, i) => {
          el.style.transitionDelay = `${Math.min(i, 8) * 50}ms`;
        });
      });
      const nodes = document.querySelectorAll("[data-reveal]");
      if (reduce) {
        nodes.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        nodes.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
