# Web (Astro) — public API base for contact form
PUBLIC_API_URL=http://localhost:8787

# API (Hono)
PORT=8787

# CORS — comma-separated exact origins (no trailing slash)
# Local:  http://localhost:4321
# Prod:   https://www.codifypros.com,https://codifypros.com
CORS_ORIGIN=http://localhost:4321

# Contact delivery
# - stub (default): logs a full brief to the API console — no email leaves the box
# - resend: sends to CONTACT_TO_EMAIL via Resend (requires RESEND_API_KEY)
EMAIL_PROVIDER=stub
CONTACT_TO_EMAIL=contact@codifypros.io
# CONTACT_FROM_EMAIL must be a verified Resend domain sender, e.g.:
# CONTACT_FROM_EMAIL=CodifyPros <noreply@codifypros.io>
# RESEND_API_KEY=re_xxxxxxxx
